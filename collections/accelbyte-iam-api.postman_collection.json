                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "code_verifier",
                  "value": "<string>",
                  "description": "PKCE code verifier."
                }
              ]
            }
          },

{
  "opencollection": "1.0.0",
  "info": {
    "name": "AccelByte Gaming Services (AGS) Achievement Statistics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Statistics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a player's stat items.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://demo.accelbyte.io/social/v1/namespaces/:namespace/users/:userId/statitems",
            "params": [
              {
                "name": "namespace",
                "value": "demogame",
                "type": "path",
                "description": "The game namespace the request is scoped to."
              },
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List a player's stat items."
        },
        {
          "info": {
            "name": "Bulk update a player's stat item values.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://demo.accelbyte.io/social/v1/namespaces/:namespace/users/:userId/statitems/value/bulk",
            "params": [
              {
                "name": "namespace",
                "value": "demogame",
                "type": "path",
                "description": "The game namespace the request is scoped to."
              },
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk update a player's stat item values."
        }
      ]
    }
  ],
  "bundled": true
}